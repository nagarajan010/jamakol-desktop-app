<UserControl x:Class="JamakolAstrology.Controls.LearningModulePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JamakolAstrology.Controls"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: Categories and Notes -->
        <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="0,0,1,0" Background="#f9f9f9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Learning Notes" FontWeight="Bold" FontSize="16" Padding="10"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Content="+ Category" Width="80" Height="25" Margin="5" Click="BtnAddCategory_Click"/>
                    <Button Content="+ Note" Width="80" Height="25" Margin="5" Click="BtnAddNote_Click"/>
                </StackPanel>

                <TreeView x:Name="NotesTreeView" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectedItemChanged="NotesTreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Notes}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,5" />
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Margin="2,3"/>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Delete button for selected item -->
                <Button Grid.Row="3" Content="Delete Selected" Height="30" Margin="10" Background="#ffdddd" Foreground="#cc0000" Click="BtnDelete_Click"/>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#ddd" Cursor="SizeWE"/>

        <!-- Right Content Area -->
        <Grid Grid.Column="2" x:Name="ContentArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar / Header -->
            <Border Grid.Row="0" Background="#eee" Padding="10" BorderBrush="#ccc" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="Title:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtNoteTitle" Width="300" Height="25" VerticalAlignment="Center" Padding="2" TextChanged="TxtNoteTitle_TextChanged"/>
                    </StackPanel>

                    <Button x:Name="BtnToggleEdit" Grid.Column="1" Content="Edit" Width="80" Height="30" Margin="0,0,10,0" Click="BtnToggleEdit_Click"/>
                    <Button x:Name="BtnSave" Grid.Column="2" Content="Save" Width="80" Height="30" Background="#dcedc8" Click="BtnSave_Click"/>
                </Grid>
            </Border>

            <!-- Editor / Preview Area -->
            <Grid Grid.Row="1" Margin="10">
                <!-- Live Preview View (Markdig) -->
                <markdig:MarkdownViewer x:Name="MarkdownPreview" Margin="10" Foreground="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Edit View (AvalonEdit) -->
                <Grid x:Name="EditGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Formatting Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#f1f1f1" Margin="0,0,0,5">
                        <Button Content="B" FontWeight="Bold" Width="30" Height="25" Margin="2" Click="BtnBold_Click" ToolTip="Bold"/>
                        <Button Content="I" FontStyle="Italic" Width="30" Height="25" Margin="2" Click="BtnItalic_Click" ToolTip="Italic"/>
                        <Button Content="H1" FontWeight="Bold" Width="30" Height="25" Margin="2" Click="BtnHeading_Click" ToolTip="Heading 1"/>
                        <Button Content="List" Width="40" Height="25" Margin="2" Click="BtnList_Click" ToolTip="Unordered List"/>
                        <Button Content="Link" Width="40" Height="25" Margin="2" Click="BtnLink_Click" ToolTip="Insert Link"/>
                    </StackPanel>

                    <avalonEdit:TextEditor x:Name="MarkdownEditor"
                                           Grid.Row="1"
                                           SyntaxHighlighting="MarkDown"
                                           FontFamily="Consolas"
                                           FontSize="11pt"
                                           ShowLineNumbers="True"
                                           WordWrap="True"
                                           TextChanged="MarkdownEditor_TextChanged"
                                           BorderBrush="#ccc" BorderThickness="1"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
