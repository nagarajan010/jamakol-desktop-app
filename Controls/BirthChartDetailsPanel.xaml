<UserControl x:Class="JamakolAstrology.Controls.BirthChartDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JamakolAstrology.Controls"
             xmlns:res="clr-namespace:JamakolAstrology.Resources">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <StackPanel>
            <!-- Planetary Positions -->
            <Border Background="#fffff8" CornerRadius="5" Padding="5" Margin="0,0,0,5" BorderBrush="#ddd" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.PlanetaryPositions}" FontSize="14" FontWeight="Bold" 
                               Foreground="#cc0000" Margin="0,0,0,5"/>
                    <controls:JamakolPlanetGrid x:Name="PlanetGridControl"/>
                </StackPanel>
            </Border>
            
            <!-- Special Lagnas & Upagrahas -->
            <Border Background="#fffff8" CornerRadius="5" Padding="5" Margin="0,0,0,5" BorderBrush="#ddd" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Special Lagnas &amp; Upagrahas" FontSize="14" FontWeight="Bold"
                               Foreground="#cc0000" Margin="0,0,0,5"/>
                    <DataGrid x:Name="SpecialLagnasGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserSortColumns="False" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#eee" Background="Transparent" RowBackground="Transparent"
                              BorderThickness="0" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Code}" Width="Auto" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Point" Binding="{Binding Name}" Width="Auto"/>
                            <DataGridTextColumn Header="Sign" Binding="{Binding SignName}" Width="Auto"/>
                            <DataGridTextColumn Header="Degree" Binding="{Binding Degree}" Width="Auto"/>
                            <DataGridTextColumn Header="Nakshatra" Binding="{Binding NakshatraName}" Width="Auto"/>
                            <DataGridTextColumn Header="Pada" Binding="{Binding Pada}" Width="Auto"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" Foreground="#8a6d00"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Bottom Details Area -->
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Natal Details -->
                <Border Grid.Column="0" Background="#fffff8" CornerRadius="5" Padding="10" Margin="0,0,5,0" BorderBrush="#ddd" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.NatalChartDetails}" FontWeight="Bold" Foreground="#990000" Margin="0,0,0,5"/>
                        <TextBlock x:Name="NatalDetailsText" FontFamily="Consolas" FontSize="12" Foreground="#333"/>
                    </StackPanel>
                </Border>
                
                <!-- Ashtakavarga -->
                <Border Grid.Column="1" Background="#fffff8" CornerRadius="5" Padding="5" Margin="5,0,0,0" BorderBrush="#ddd" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.TabAshtakavarga}" FontWeight="Bold" Foreground="#990000" Margin="0,0,0,5"/>
                        <controls:AshtakavargaDetailsPanel x:Name="AshtakavargaControl" Height="Auto"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
