<UserControl x:Class="JamakolAstrology.Controls.TithiPraveshaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JamakolAstrology.Controls"
             xmlns:res="clr-namespace:JamakolAstrology.Resources">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Year Selection Bar -->
        <Border Grid.Row="0" Background="#fff8f0" Padding="8" Margin="0,0,0,2" BorderBrush="#ddd" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Year: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                <ComboBox x:Name="YearComboBox" Width="100" Height="24" Margin="5,0,0,0"/>
                <Button x:Name="CalculateButton" Content="Calculate" Margin="10,0,0,0" Padding="12,3" 
                        Background="#cc0000" Foreground="White" FontWeight="SemiBold" 
                        Click="CalculateButton_Click" IsEnabled="False"/>
                <TextBlock x:Name="StatusText" Text="" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#666" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Same layout as BirthChartDetailsPanel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <!-- Planetary Positions -->
                <Border Background="#fffff8" CornerRadius="5" Padding="5" Margin="0,0,0,5" BorderBrush="#ddd" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.PlanetaryPositions}" FontSize="14" FontWeight="Bold" 
                                   Foreground="#cc0000" Margin="0,0,0,5"/>
                        <controls:JamakolPlanetGrid x:Name="PlanetGridControl"/>
                    </StackPanel>
                </Border>
                
                <!-- Bottom Details Area -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Chart Details (same style as Natal Details) -->
                    <Border Grid.Column="0" Background="#fffff8" CornerRadius="5" Padding="10" Margin="0,0,5,0" BorderBrush="#ddd" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tithi Pravesha Details" FontWeight="Bold" Foreground="#990000" Margin="0,0,0,5"/>
                            <TextBlock x:Name="NatalDetailsText" FontFamily="Consolas" FontSize="12" Foreground="#333" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Ashtakavarga -->
                    <Border Grid.Column="1" Background="#fffff8" CornerRadius="5" Padding="5" Margin="5,0,0,0" BorderBrush="#ddd" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.TabAshtakavarga}" FontWeight="Bold" Foreground="#990000" Margin="0,0,0,5"/>
                            <controls:AshtakavargaDetailsPanel x:Name="AshtakavargaControl" Height="Auto"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
