<UserControl x:Class="JamakolAstrology.Controls.PrasannaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:JamakolAstrology.Resources">
    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#ffebe0" BorderBrush="#ff9966" BorderThickness="1" CornerRadius="5" Padding="10">
        <StackPanel>
            <TextBlock Text="{x:Static res:Strings.PrasannaTitle}" FontSize="14" FontWeight="Bold" 
                       Foreground="#ff6600" Margin="0,0,0,10"/>
            
            <!-- Planet towards Udhayam -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelPlanetTowardsUdhayam}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="PlanetTowardsUdhayamText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Udhayam Lord & Bhava -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelUdhayamLordBhava}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="UdhayamLordBhavaText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Arudam Bhava -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelArudamBhava}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="ArudamBhavaText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Planet towards Arudam -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelPlanetTowardsArudam}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="PlanetTowardsArudamText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Planet towards Kavippu -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelPlanetTowardsKavippu}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="PlanetTowardsKavippuText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Bhava in Kavippu -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelBhavaInKavippu}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="BhavaInKavippuText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Exalted Planets -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelExaltedPlanets}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="ExaltedPlanetsText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Debilitated Planets -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelDebilitatedPlanets}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="DebilitatedPlanetsText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Parivarthana Planets -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelParivarthanaPlanets}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="ParivarthanaPlanetsText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Planet → Emakandam -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelPlanetTowardsEmakandam}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="EmakandamText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Planet → Rahu Time -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelPlanetInRahuTime}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="RahuTimeText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
            
            <!-- Planet → Mrithyu -->
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.LabelPlanetTowardsMrithyu}" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="MrithyuText" Grid.Column="1" Text="-" Foreground="#ff6600" FontWeight="SemiBold" FontSize="11"/>
            </Grid>

            <!-- ═══════════ WARNING ALERTS ═══════════ -->

            <!-- W1: Udayam Lord in dusthana 6/8/12 -->
            <Border x:Name="AlertUdayamLordBadHouse" Visibility="Collapsed"
                    Background="#fff8e1" BorderBrush="#f57c00" BorderThickness="3,0,0,0"
                    CornerRadius="0,4,4,0" Margin="0,6,0,2" Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" FontSize="18" Foreground="#f57c00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Udayam Lord in Dusthana" FontWeight="Bold" Foreground="#e65100" FontSize="11"/>
                        <TextBlock x:Name="AlertUdayamLordBadHouseText" Foreground="#bf360c" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- W2: Udayam Lord debilitated -->
            <Border x:Name="AlertUdayamLordDebil" Visibility="Collapsed"
                    Background="#ffebee" BorderBrush="#c62828" BorderThickness="3,0,0,0"
                    CornerRadius="0,4,4,0" Margin="0,2" Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" FontSize="18" Foreground="#c62828" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Udayam Lord Debilitated" FontWeight="Bold" Foreground="#c62828" FontSize="11"/>
                        <TextBlock x:Name="AlertUdayamLordDebilText" Foreground="#b71c1c" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- W3: Debilitated planet in Udayam sign -->
            <Border x:Name="AlertDebilInUdayam" Visibility="Collapsed"
                    Background="#ffebee" BorderBrush="#c62828" BorderThickness="3,0,0,0"
                    CornerRadius="0,4,4,0" Margin="0,2" Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" FontSize="18" Foreground="#c62828" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Debilitated Planet in Udayam" FontWeight="Bold" Foreground="#c62828" FontSize="11"/>
                        <TextBlock x:Name="AlertDebilInUdayamText" Foreground="#b71c1c" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- W4: Arudam Lord in dusthana 6/8/12 -->
            <Border x:Name="AlertArudamLordBadHouse" Visibility="Collapsed"
                    Background="#fff8e1" BorderBrush="#f57c00" BorderThickness="3,0,0,0"
                    CornerRadius="0,4,4,0" Margin="0,6,0,2" Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" FontSize="18" Foreground="#f57c00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Arudam Lord in Dusthana" FontWeight="Bold" Foreground="#e65100" FontSize="11"/>
                        <TextBlock x:Name="AlertArudamLordBadHouseText" Foreground="#bf360c" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- W5: Arudam Lord debilitated -->
            <Border x:Name="AlertArudamLordDebil" Visibility="Collapsed"
                    Background="#ffebee" BorderBrush="#c62828" BorderThickness="3,0,0,0"
                    CornerRadius="0,4,4,0" Margin="0,2" Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" FontSize="18" Foreground="#c62828" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Arudam Lord Debilitated" FontWeight="Bold" Foreground="#c62828" FontSize="11"/>
                        <TextBlock x:Name="AlertArudamLordDebilText" Foreground="#b71c1c" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- W6: Debilitated planet in Arudam sign -->
            <Border x:Name="AlertDebilInArudam" Visibility="Collapsed"
                    Background="#ffebee" BorderBrush="#c62828" BorderThickness="3,0,0,0"
                    CornerRadius="0,4,4,0" Margin="0,2" Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" FontSize="18" Foreground="#c62828" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Debilitated Planet in Arudam" FontWeight="Bold" Foreground="#c62828" FontSize="11"/>
                        <TextBlock x:Name="AlertDebilInArudamText" Foreground="#b71c1c" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
